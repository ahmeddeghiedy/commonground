# Inventory provider: demo | wadjet | custom
INVENTORY_PROVIDER=demo
INVENTORY_PROVIDER_NAME=

# Wadjet adapter. Set INVENTORY_PROVIDER=wadjet once the private endpoint and
# server-side key are available. Secrets are never sent to the browser.
WADJET_INVENTORY_URL=
WADJET_API_KEY=

# Provider-neutral alternative. Set INVENTORY_PROVIDER=custom.
CUSTOM_INVENTORY_URL=
CUSTOM_INVENTORY_API_KEY=

# Optional adapter controls shared by Wadjet/custom integrations.
INVENTORY_REQUEST_METHOD=GET
INVENTORY_AUTH_HEADER=authorization
INVENTORY_AUTH_SCHEME=Bearer
# Optional JSON object for providers requiring additional server-only headers,
# e.g. {"X-Affiliate-Id":"123456"}. Store as a Sites secret.
INVENTORY_EXTRA_HEADERS_JSON=
# Dot path to the hotel array, e.g. data.hotels. Leave blank for auto-detection.
INVENTORY_RESPONSE_PATH=
# Seconds to cache inventory responses server-side
INVENTORY_CACHE_SECONDS=300

# Optional for a public judging URL. Enroll the deployed origin in Chrome's
# WebMCP origin trial, then paste its public token here and rebuild/deploy.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# Optional immutable release label exposed by GET /api/health
COMMONGROUND_RELEASE=
