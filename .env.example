# TrailTrix inventory integration (optional; falls back to seed data)
TRAILTRIX_INVENTORY_URL=
TRAILTRIX_API_KEY=
# Seconds to cache inventory responses server-side
INVENTORY_CACHE_SECONDS=300

# Optional for a public judging URL. Enroll the deployed origin in Chrome's
# WebMCP origin trial, then paste its public token here and rebuild/deploy.
WEBMCP_ORIGIN_TRIAL_TOKEN=
